local espObjects = {}
local function cleanESP(plr)
    if espObjects[plr] then
        for _, obj in pairs(espObjects[plr]) do obj:Remove() end
        espObjects[plr] = nil
    end
end

local function buildESP(plr)
    if espObjects[plr] then return end
    espObjects[plr] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        HealthBarOutline = Drawing.new("Square"),
        HealthBarFill = Drawing.new("Square"),
        Snapline = Drawing.new("Line"),
        Distance = Drawing.new("Text")
    }
    local ui = espObjects[plr]
    ui.Box.Thickness = 1.5
    ui.Box.Color = Color3.fromRGB(235, 134, 52)
    ui.Box.Filled = false
    
    ui.Name.Size = 14
    ui.Name.Center = true
    ui.Name.Outline = true
    ui.Name.Color = Color3.fromRGB(255, 255, 255)
    
    ui.HealthBarOutline.Thickness = 1
    ui.HealthBarOutline.Color = Color3.fromRGB(0, 0, 0)
    ui.HealthBarOutline.Filled = true
    
    ui.HealthBarFill.Thickness = 1
    ui.HealthBarFill.Color = Color3.fromRGB(0, 255, 0)
    ui.HealthBarFill.Filled = true
    
    ui.Snapline.Thickness = 1
    ui.Snapline.Color = Color3.fromRGB(255, 255, 255)
    
    ui.Distance.Size = 13
    ui.Distance.Center = true
    ui.Distance.Outline = true
    ui.Distance.Color = Color3.fromRGB(255, 255, 255)
end

Players.PlayerAdded:Connect(buildESP)
Players.PlayerRemoving:Connect(cleanESP)
local currentPlayers = Players:GetPlayers()
for i = 1, #currentPlayers do
    local p = currentPlayers[i]
    if p ~= player then buildESP(p) end
end

local function isPartVisible(targetPart, character)
    local origin = camera.CFrame.Position
    local direction = targetPart.Position - origin
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {player.Character, character, camera}
    local res = workspace:Raycast(origin, direction, raycastParams)
    return res == nil
end

-- =============================================================================
-- COMPONENT EXECUTION ENGINE LOOP
-- =============================================================================
runService.RenderStepped:Connect(function()
    local viewportSize = camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local screenBottom = Vector2.new(viewportSize.X / 2, viewportSize.Y)
    local char, hum, hrp = getCharElements()
    
    -- Real-time Walkspeed and Jump Syncing
    if char and hum and hrp and not flying then
        local desiredSpeed = Library.Options.WalkSpeedSlider.Value
        if hum.WalkSpeed ~= desiredSpeed then
            if not Library.Toggles.OrbitStrafeActive.Value then
                hum.WalkSpeed = desiredSpeed
            end
        end
        local desiredJump = Library.Options.JumpPowerSlider.Value
        if hum.JumpPower ~= desiredJump then
            hum.JumpPower = desiredJump
        end
    end

    -- FOV Radius Alignment Updates
    FOVCircle.Position = screenCenter
    FOVCircle.Radius = Library.Options.FOVSizeRegulator.Value
    FOVCircle.Visible = Library.Toggles.ShowFOVCircle.Value

    currentTarget = nil
    local minimumRadius = Library.Options.FOVSizeRegulator.Value
    local activePlayers = Players:GetPlayers()
    
    -- Combat Target Filters
    for i = 1, #activePlayers do
        local p = activePlayers[i]
        if p ~= player and p.Character then
            local pChar = p.Character
            local pHum = pChar:FindFirstChild("Humanoid")
            local pHrp = pChar:FindFirstChild("HumanoidRootPart")
            
            if pHrp and pHum and pHum.Health > 0 then
                local targetPart = pChar:FindFirstChild("Head") or pHrp
                local passWallcheck = true
                if Library.Toggles.WallCheckActive.Value then
                    passWallcheck = isPartVisible(targetPart, pChar)
                end
                
                if passWallcheck then
                    local vector, visible = camera:WorldToViewportPoint(targetPart.Position)
                    if visible then
                        local delta = (Vector2.new(vector.X, vector.Y) - screenCenter).Magnitude
                        if delta < minimumRadius then 
                            minimumRadius = delta
                            currentTarget = p
                        end
                    end
                end
            end
        end
    end

    -- Execution of Combat Toggles
    if currentTarget and currentTarget.Character then
        local tChar = currentTarget.Character
        local tHrp = tChar:FindFirstChild("HumanoidRootPart")
        if tHrp then
            local coreTargetPart = tChar:FindFirstChild("Head") or tHrp
            
            if Library.Toggles.AimbotActive.Value then
                camera.CFrame = CFrame.new(camera.CFrame.Position, coreTargetPart.Position)
            end
            
            if Library.Toggles.OrbitStrafeActive.Value and hrp and not flying then
                angle = angle + (Library.Options.OrbitSpeed.Value / 100)
                local offset = Vector3.new(math.sin(angle) * Library.Options.OrbitRadius.Value, 2, math.cos(angle) * Library.Options.OrbitRadius.Value)
                hrp.CFrame = CFrame.new(tHrp.Position + offset, tHrp.Position)
                if hum then hum.WalkSpeed = 0 end
            end

            if Library.Toggles.BackstabActive.Value and hrp then
                if (tHrp.Position - hrp.Position).Magnitude < 40 then
                    hrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3.5)
                end
            end
        end
    end

    -- Process Rendering Core Master ESP Matrix
    local masterESP = Library.Toggles.MESPActive.Value
    local boxToggle = Library.Toggles.BoxESPActive.Value
    local nameToggle = Library.Toggles.NameESPActive.Value
    local healthToggle = Library.Toggles.HealthESPActive.Value
    local snapToggle = Library.Toggles.SnaplinesESPActive.Value
    local distToggle = Library.Toggles.DistanceESPActive.Value

    for i = 1, #activePlayers do
        local p = activePlayers[i]
        local ui = espObjects[p]
        if ui then
            local rc = p.Character
            local rh = rc and rc:FindFirstChildOfClass("Humanoid")
            local rp = rc and rc:FindFirstChild("HumanoidRootPart")

            if masterESP and rc and rh and rp and rh.Health > 0 then
                local coords, onScreen = camera:WorldToViewportPoint(rp.Position)
                if onScreen then
                    local top = camera:WorldToViewportPoint(rp.Position + Vector3.new(0, 3, 0))
                    local bottom = camera:WorldToViewportPoint(rp.Position - Vector3.new(0, 3.5, 0))
                    local h = math.abs(top.Y - bottom.Y)
                    local w = h * 0.65
                    local x = coords.X - (w / 2)
                    
                    local baseOrigin = hrp and hrp.Position or camera.CFrame.Position
                    local distanceStuds = math.floor((rp.Position - baseOrigin).Magnitude)

                    -- 1. Bounding Boxes
                    ui.Box.Size = Vector2.new(w, h)
                    ui.Box.Position = Vector2.new(x, top.Y)
                    ui.Box.Visible = boxToggle

                    -- 2. Display Label Identity Names
                    ui.Name.Text = p.Name
                    ui.Name.Position = Vector2.new(coords.X, top.Y - 16)
                    ui.Name.Visible = nameToggle

                    -- 3. Dynamic Health Calculation Meters
                    if healthToggle then
                        local pct = math.clamp(rh.Health / rh.MaxHealth, 0, 1)
                        local barH = h * pct
                        
                        ui.HealthBarOutline.Size = Vector2.new(4, h)
                        ui.HealthBarOutline.Position = Vector2.new(x - 6, top.Y)
                        ui.HealthBarOutline.Visible = true
                        
                        ui.HealthBarFill.Size = Vector2.new(2, barH)
                        ui.HealthBarFill.Position = Vector2.new(x - 5, top.Y + (h - barH))
                        ui.HealthBarFill.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
                        ui.HealthBarFill.Visible = true
                    else
                        ui.HealthBarOutline.Visible = false
                        ui.HealthBarFill.Visible = false
                    end

                    -- 4. Bottom Point Center Target Snaplines
                    ui.Snapline.From = screenBottom
                    ui.Snapline.To = Vector2.new(coords.X, bottom.Y)
                    ui.Snapline.Visible = snapToggle

                    -- 5. Distance Data Tracking
                    ui.Distance.Text = tostring(distanceStuds) .. " studs"
                    ui.Distance.Position = Vector2.new(coords.X, bottom.Y + 4)
                    ui.Distance.Visible = distToggle
                else
                    ui.Box.Visible = false ui.Name.Visible = false ui.HealthBarOutline.Visible = false ui.HealthBarFill.Visible = false ui.Snapline.Visible = false ui.Distance.Visible = false
                end
            else
                ui.Box.Visible = false ui.Name.Visible = false ui.HealthBarOutline.Visible = false ui.HealthBarFill.Visible = false ui.Snapline.Visible = false ui.Distance.Visible = false
            end
        end
    end
end)

