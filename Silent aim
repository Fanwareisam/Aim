-- =============================================================================
-- Flight Propulsion Mechanics
-- =============================================================================
local function stopFlyingEngine()
    flying = false
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    local _, hum = getCharElements()
    if hum then hum.PlatformStand = false end
end

local function startFlyingEngine()
    local char, hum, hrp = getCharElements()
    if not hrp or not hum then return end
    flying = true
    hum.PlatformStand = true
    
    bg = Instance.new("BodyGyro", hrp)
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = hrp.CFrame
    
    bv = Instance.new("BodyVelocity", hrp)
    bv.velocity = Vector3.new(0, 0.1, 0)
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    
    task.spawn(function()
        while flying and task.wait() do
            local c_char, c_hum, c_hrp = getCharElements()
            if not c_hrp or not c_hum or not Library.Toggles.FlyStateActive.Value then break end
            c_hum.PlatformStand = true
            
            local direction = Vector3.new(0, 0, 0)
            if keysDown[Enum.KeyCode.W] then direction = direction + camera.CFrame.LookVector end
            if keysDown[Enum.KeyCode.S] then direction = direction - camera.CFrame.LookVector end
            if keysDown[Enum.KeyCode.A] then direction = direction - camera.CFrame.RightVector end
            if keysDown[Enum.KeyCode.D] then direction = direction + camera.CFrame.RightVector end
            if inputService:IsKeyDown(Enum.KeyCode.Space) then direction = direction + Vector3.new(0, 1, 0) end
            
            if direction.Magnitude > 0 then
                bv.velocity = direction.Unit * Library.Options.FlySpeedSlider.Value
            else
                bv.velocity = Vector3.new(0, 0, 0)
            end
            bg.cframe = camera.CFrame
        end
        stopFlyingEngine()
    end)
end

Library.Toggles.FlyStateActive:OnChanged(function()
    if Library.Toggles.FlyStateActive.Value then startFlyingEngine() else stopFlyingEngine() end
end)

inputService.InputBegan:Connect(function(i, p) if not p then keysDown[i.KeyCode] = true end end)
