local function isTeammate(player)
    if not Settings.TeamCheck then return false end
    local localTeam = LocalPlayer.Team
    local playerTeam = player.Team
    if localTeam and playerTeam then
        return localTeam == playerTeam
    end
    return false
end

local function getClosestPlayerToMouse()
    local closest = nil
    local shortestDist = Settings.FOV
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isTeammate(player) then
            local character = player.Character
            if character then
                local humanoid = character:FindFirstChild("Humanoid")
                local head = character:FindFirstChild("Head")
                if humanoid and humanoid.Health > 0 and head then
                    local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
                    if onScreen then
                        local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (screenVec - mousePos).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closest = player
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function getTargetScreenPos(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return nil end
    local head = targetPlayer.Character:FindFirstChild("Head")
    if not head then return nil end
    local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
    if not onScreen then return nil end
    return Vector2.new(screenPos.X, screenPos.Y)
end

local function updateHighlight()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local highlight = Highlights[player]
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Parent = player.Character
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.FillTransparency = 0.5
                Highlights[player] = highlight
            end
            highlight.Enabled = Settings.Highlight and Settings.Enabled and CurrentTarget == player
        end
    end
end

-- Silent Aim by intercepting mouse movements before they're processed
local function setupMouseSilentAim()
    local originalInputBegan = UserInputService.InputBegan
    local originalInputChanged = UserInputService.InputChanged
    
    -- Hook mouse button clicks (shooting)
    UserInputService.InputBegan = function(input, gameProcessed)
        if Settings.Enabled and input.UserInputType == Enum.UserInputType.MouseButton1 then
            if Settings.HitChance >= math.random(1, 100) then
                local target = getClosestPlayerToMouse()
                if target and target.Character then
                    local targetScreenPos = getTargetScreenPos(target)
                    if targetScreenPos then
                        -- Move mouse to target then shoot
                        local originalPos = UserInputService:GetMouseLocation()
                        mousemoveabs(targetScreenPos.X, targetScreenPos.Y)
                        task.wait()
                        local result = originalInputBegan(input, gameProcessed)
                        mousemoveabs(originalPos.X, originalPos.Y)
                        return result
                    end
                end
            end
        end
        return originalInputBegan(input, gameProcessed)
    end
end

local function onRender()
    if not Settings.Enabled then 
        CurrentTarget = nil
        return 
    end
    
    updateFOVCircle()
    CurrentTarget = getClosestPlayerToMouse()
    updateHighlight()
end

-- Hook mouse movement for smooth aiming
local mouseMoveConnection
local function setupMouseMoveHook()
    if mouseMoveConnection then mouseMoveConnection:Disconnect() end
    
    mouseMoveConnection = UserInputService.InputChanged:Connect(function(input, gameProcessed)
        if not Settings.Enabled or gameProcessed then return end
        
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local target = getClosestPlayerToMouse()
            if target and Settings.HitChance >= math.random(1, 100) then
                local targetScreenPos = getTargetScreenPos(target)
                if targetScreenPos then
                    local center = UserInputService:GetMouseLocation()
                    local newPos = center:Lerp(targetScreenPos, 0.3)
                    mousemoveabs(newPos.X, newPos.Y)
                end
            end
        end
    end)
end

